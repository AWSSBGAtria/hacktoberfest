# Copy to .env (gitignored - never commit real credentials).

# Production: paste the TiDB Cloud connection string here.
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/hacktober2026

# Local fallback when DATABASE_URL is unset. There is deliberately no
# baked-in default password any more (a real one used to sit in
# server/store.js and design.md) - set all four, DB_PASSWORD especially,
# or the event-day server cannot reach the database.
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=hacktober2026
# PORT=3001

# Entry window. Submissions are FROZEN unless this is exactly "1": every
# write answers 503 while it is unset, so the deployed board is closed by
# default and reopening it is a variable, not a code change. Set it in
# Vercel -> Settings -> Environment Variables, then redeploy.
# SUBMISSIONS_OPEN=1

# Extra hosts allowed to call /api cross-origin, comma separated. A
# same-origin request always passes, so this is only needed if a separate
# frontend origin must post scores. server/guard.js rejects every other
# cross-site caller with 403.
# ALLOWED_ORIGINS=https://admin.example.com
